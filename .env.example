# Copy to .env (or export these). Nothing here has a usable default credential.

# --- storage ---------------------------------------------------------------
LOGNODE_POSTGRES_DSN=postgresql://lognode:REPLACE_ME@localhost:5432/lognode

# --- listeners -------------------------------------------------------------
# Comma-separated. Bind to loopback unless you mean to expose ingest.
LOGNODE_BIND_HOST=127.0.0.1
LOGNODE_HTTP_PORT=9514
LOGNODE_SYSLOG_PORT=1514

# --- model backend ---------------------------------------------------------
# The templatizer needs any chat model that can return JSON.
#
# Ollama (native /api/chat):
LOGNODE_LLM_URL=http://localhost:11434/api/chat
LOGNODE_LLM_MODEL=qwen2.5-coder:1.5b
#
# LiteLLM router, vLLM, OpenAI -- anything OpenAI-shaped:
# LOGNODE_LLM_URL=http://localhost:4000/v1/chat/completions
# LOGNODE_LLM_MODEL=whatever-the-router-calls-it
# LOGNODE_LLM_API_KEY=
#
# The wire format is inferred from the URL; force it only if that guess is wrong:
# LOGNODE_LLM_STYLE=openai
# A hosted model is not a local 1.5b -- raise this if you use one:
# LOGNODE_LLM_TIMEOUT=30

# --- topology --------------------------------------------------------------
# Copy topology.example.json to topology.json and describe your own fleet.
# Omit it entirely and every observed peer becomes external:<ip>.
LOGNODE_TOPOLOGY_FILE=./topology.json
LOGNODE_SELF_NODE=hub

# --- optional alerting -----------------------------------------------------
# DISCORD_WEBHOOK_URL=
# ALERT_COOLDOWN_SECONDS=300
# UNIT_ALERT_COOLDOWN_SECONDS=21600
